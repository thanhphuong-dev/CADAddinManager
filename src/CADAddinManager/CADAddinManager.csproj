<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net48</TargetFramework>
    <Configurations>Debug A20;Debug A21;Debug A22;Debug A23;Debug A24;Debug A25;Debug A26;Debug V26;Debug Z21;Debug Z26</Configurations>
    <Configurations>$(Configurations);Release A20;Release A21;Release A22;Release A23;Release A24;Release A25;Release A26;Release V26;Release Z21;Release Z26</Configurations>
    <CADVersion>2026</CADVersion>
    <CADTrimVersion>26</CADTrimVersion>
    <RootNamespace>CADAddinManager</RootNamespace>
    <AssemblyName>CADAddinManager</AssemblyName>
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <Description>CAD Add-in Manager for AutoCAD</Description>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('Debug'))">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release'))">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('A20'))">
    <CADVersion>2020</CADVersion>
    <CADTrimVersion>20</CADTrimVersion>
    <DefineConstants>$(DefineConstants);A20</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('A21'))">
    <CADVersion>2021</CADVersion>
    <CADTrimVersion>21</CADTrimVersion>
    <DefineConstants>$(DefineConstants);A21</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('A22'))">
    <CADVersion>2022</CADVersion>
    <CADTrimVersion>22</CADTrimVersion>
    <DefineConstants>$(DefineConstants);A22</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('A23'))">
    <CADVersion>2023</CADVersion>
    <CADTrimVersion>23</CADTrimVersion>
    <DefineConstants>$(DefineConstants);A23</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('A24'))">
    <CADVersion>2024</CADVersion>
    <CADTrimVersion>24</CADTrimVersion>
    <DefineConstants>$(DefineConstants);A24</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('A25'))">
    <CADVersion>2025</CADVersion>
    <CADTrimVersion>25</CADTrimVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);A25</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('A26'))">
    <CADVersion>2026</CADVersion>
    <CADTrimVersion>26</CADTrimVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);A26</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('V26'))">
    <CADVersion>2026</CADVersion>
    <CADTrimVersion>V26</CADTrimVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);VINACAD;V26</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <VinaCadInstallDir Condition="'$(VinaCadInstallDir)' == ''">C:\Program Files\VinaCAD\VinaCAD 2026</VinaCadInstallDir>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Z21'))">
    <CADVersion>2021</CADVersion><CADTrimVersion>Z21</CADTrimVersion>
    <DefineConstants>$(DefineConstants);ZWCAD;Z21</DefineConstants>
    <ZwcadInstallDir Condition="'$(ZwcadInstallDir)' == ''">C:\Program Files\ZWSOFT\ZWCAD 2021</ZwcadInstallDir>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Z26'))">
    <CADVersion>2026</CADVersion><CADTrimVersion>Z26</CADTrimVersion>
    <DefineConstants>$(DefineConstants);ZWCAD;Z26</DefineConstants>
    <ZwcadInstallDir Condition="'$(ZwcadInstallDir)' == ''">C:\Program Files\ZWSOFT\ZWCAD 2026</ZwcadInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\dev.ico" />
    <Resource Include="Resources\dev.ico" />
  </ItemGroup>

  <ItemGroup Condition="$(Configuration.Contains('V26'))">
    <Reference Include="TD_Mgd_Net8_26.12_17">
      <HintPath>$(VinaCadInstallDir)\TD_Mgd_Net8_26.12_17.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VinaCADCoreMgd_Net8">
      <HintPath>$(VinaCadInstallDir)\VinaCADCoreMgd_Net8.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="$(Configuration.Contains('Z21')) Or $(Configuration.Contains('Z26'))">
    <Reference Include="ZwManaged"><HintPath>$(ZwcadInstallDir)\ZwManaged.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ZwDatabaseMgd"><HintPath>$(ZwcadInstallDir)\ZwDatabaseMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ZcWindows"><HintPath>$(ZwcadInstallDir)\ZcWindows.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ZdWindows"><HintPath>$(ZwcadInstallDir)\ZdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resource.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="View\AssemblyLoader.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <Page Update="View\FrmAddInManager.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Chuongmep.Acad.Api.acmgd" Version="$(CADVersion).*" Condition="!$(Configuration.Contains('V26')) And !$(Configuration.Contains('Z21')) And !$(Configuration.Contains('Z26'))">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Chuongmep.Acad.Api.acdbmgd" Version="$(CADVersion).*" Condition="!$(Configuration.Contains('V26')) And !$(Configuration.Contains('Z21')) And !$(Configuration.Contains('Z26'))">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Chuongmep.Acad.Api.accoremgd" Version="$(CADVersion).*" Condition="!$(Configuration.Contains('V26')) And !$(Configuration.Contains('Z21')) And !$(Configuration.Contains('Z26'))">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Chuongmep.Acad.Api.AdWindows" Version="$(CADVersion).*" Condition="!$(Configuration.Contains('V26')) And !$(Configuration.Contains('Z21')) And !$(Configuration.Contains('Z26'))">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" Condition="$(Configuration.Contains('V26'))" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <None Update="PackageContents.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="PackageContents.VinaCAD.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyBundleFiles" AfterTargets="CoreBuild" Condition="$(Configuration.Contains('Debug')) And '$(DeployToAutoCAD)' == 'true'">
    <ItemGroup>
      <BundleXml Include="$(ProjectDir)PackageContents.xml" />
    </ItemGroup>
    <PropertyGroup>
      <BundleRoot>$(APPDATA)\Autodesk\ApplicationPlugins\CADAddinManager.bundle\</BundleRoot>
      <BundleSourceDir>$(TargetDir.TrimEnd('\'))</BundleSourceDir>
      <BundleDestDir>$(BundleRoot)$(CADTrimVersion)</BundleDestDir>
    </PropertyGroup>
    <Message Text="Copy CADAddinManager files to $(BundleRoot)" Importance="high" />
    <Copy SourceFiles="@(BundleXml)" DestinationFolder="$(BundleRoot)" />
    <Exec Command="robocopy &quot;$(BundleSourceDir)&quot; &quot;$(BundleDestDir)&quot; /E /NFL /NDL /NJH /NJS /NP" IgnoreExitCode="true" />
  </Target>

  <Target Name="ValidateVinaCadSdk" BeforeTargets="ResolveAssemblyReferences" Condition="$(Configuration.Contains('V26'))">
    <Error Condition="!Exists('$(VinaCadInstallDir)\TD_Mgd_Net8_26.12_17.dll') Or !Exists('$(VinaCadInstallDir)\VinaCADCoreMgd_Net8.dll')"
           Text="VinaCAD 2026 .NET SDK assemblies were not found in '$(VinaCadInstallDir)'. Set -p:VinaCadInstallDir=&quot;...&quot; to the VinaCAD installation directory." />
  </Target>
  <Target Name="ValidateZwcadSdk" BeforeTargets="ResolveAssemblyReferences" Condition="$(Configuration.Contains('Z21')) Or $(Configuration.Contains('Z26'))">
    <Error Condition="!Exists('$(ZwcadInstallDir)\ZwManaged.dll') Or !Exists('$(ZwcadInstallDir)\ZwDatabaseMgd.dll') Or !Exists('$(ZwcadInstallDir)\ZcWindows.dll') Or !Exists('$(ZwcadInstallDir)\ZdWindows.dll')" Text="ZWCAD .NET SDK assemblies were not found in '$(ZwcadInstallDir)'." />
  </Target>

  <Target Name="CopyVinaCadBundleFiles" AfterTargets="CoreBuild"
          Condition="$(Configuration.Contains('V26')) And '$(DeployToVinaCAD)' == 'true'">
    <ItemGroup>
      <BundleFiles Include="$([System.IO.Path]::Combine('$(TargetDir)', '**', '*.*'))" />
    </ItemGroup>
    <PropertyGroup>
      <VinaCadBundleRoot>$(APPDATA)\VinaCAD\ApplicationPlugins\CADAddinManager.bundle\</VinaCadBundleRoot>
      <VinaCadBundleContents>$(VinaCadBundleRoot)Contents\V26\</VinaCadBundleContents>
    </PropertyGroup>
    <MakeDir Directories="$(VinaCadBundleContents)" />
    <Message Text="Deploying CAD Add-in Manager for VinaCAD to $(VinaCadBundleRoot)" Importance="high" />
    <Copy SourceFiles="$(ProjectDir)PackageContents.VinaCAD.xml"
          DestinationFiles="$(VinaCadBundleRoot)PackageContents.xml"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VinaCadBundleFiles)"
          DestinationFiles="@(VinaCadBundleFiles->'$(VinaCadBundleContents)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
